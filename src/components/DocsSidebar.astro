---
import type { DocEntry } from '../lib/docs';
import DocsIcon from './DocsIcon.astro';
import { buildDocEntryHref } from '../lib/docs';

interface Group {
  section: string;
  items: DocEntry[];
}

interface Props {
  groups: Group[];
  currentSlug?: string;
}

const { groups, currentSlug = '' } = Astro.props;
---

<aside class="docs-sidebar card-base p-3 lg:p-4">
  <div class="docs-sidebar__content">
    {groups.map((group) => (
      <details class:list={['docs-sidebar-group', group.items.some((item) => item.slug === currentSlug) && 'is-open']} open={group.items.some((item) => item.slug === currentSlug)}>
        <summary class="docs-nav-group-title">
          <DocsIcon name="folder-outline" />
          <span>{group.section}</span>
        </summary>
        <div class="docs-sidebar-links">
          {group.items.map((item) => (
            <a
              href={buildDocEntryHref(item)}
              class:list={['page-nav-item docs-sidebar-link', item.slug === currentSlug && 'active is-active']}
            >
              <span class="docs-sidebar-link__title">{item.data.title}</span>
            </a>
          ))}
        </div>
      </details>
    ))}
  </div>
</aside>
