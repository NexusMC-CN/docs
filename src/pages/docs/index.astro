---
import { getCollection } from 'astro:content';
import DocsBaseLayout from '../../layouts/DocsBaseLayout.astro';
import DocsIcon from '../../components/DocsIcon.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import { buildDocEntryHref, DEFAULT_DOC_LOCALE, filterPublicDocsByLocale, groupDocs, sortDocs } from '../../lib/docs';

const locale = DEFAULT_DOC_LOCALE;
const docs = sortDocs(filterPublicDocsByLocale(await getCollection('docs'), locale));
const groups = groupDocs(docs);
const featuredGroups = groups.map((group) => ({
  ...group,
  items: group.items.slice(0, 4),
}));
---

<DocsBaseLayout title="文档目录" description="NexusMC 文档中心目录" locale={locale}>
  <main class="docs-shell">
    <section class="docs-page-grid grid grid-cols-1 gap-4 lg:grid-cols-[280px_minmax(0,1fr)]">
      <DocsSidebar groups={groups} />

      <div class="docs-content-card card-base px-5 py-6 sm:px-7 sm:py-7">
        <div class="mb-5">
          <div class="docs-kicker docs-kicker--icon mb-2">
            <DocsIcon name="format-list-bulleted" />
            <span>Sections</span>
          </div>
          <h2 class="text-2xl font-bold text-90">文档目录</h2>
          <p class="mt-2 max-w-[72ch] text-sm leading-7 text-60">这里汇总接口、投稿流程、资源规范等文档。先选分类，再进入具体页面，会更省力。</p>
        </div>
        <div class="grid gap-4 xl:grid-cols-2">
          {featuredGroups.map((group) => (
            <section class="docs-landing-group card-base p-4 sm:p-5">
              <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="docs-section-heading text-base font-semibold text-90">
                  <DocsIcon name="folder-outline" />
                  <span>{group.section}</span>
                </h3>
              </div>
              <div class="space-y-1">
                {group.items.map((item) => (
                  <a href={buildDocEntryHref(item)} class="docs-landing-link">
                    <span class="docs-landing-link__title">{item.data.title}</span>
                    {item.data.description && <span class="docs-landing-link__desc">{item.data.description}</span>}
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
</DocsBaseLayout>
